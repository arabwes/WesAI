{
  "name": "shibam-coffee-team-portal",
  "private": true,
  "type": "module",
  "description": "Shibam Coffee website and Cloudflare-backed employee portal.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-pages.mjs",
    "dev": "wrangler pages dev .",
    "db:migrate:local": "wrangler d1 migrations apply shibam-team --local",
    "db:migrate:preview": "wrangler d1 migrations apply shibam-team-preview --remote --env preview",
    "db:migrate:production": "wrangler d1 migrations apply shibam-team --remote",
    "catalog:build-seed": "node scripts/build-catalog-seed.mjs",
    "legacy:build-import": "node scripts/build-legacy-import.mjs",
    "notifications:set-secret": "wrangler secret put RESEND_API_KEY --config workers/notifications/wrangler.jsonc",
    "notifications:deploy": "wrangler deploy --config workers/notifications/wrangler.jsonc",
    "pages:preview": "npm run build && wrangler pages deploy dist --project-name yemenicoffeeco --branch main",
    "test": "node --test tests/*.test.js",
    "test:mobile": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "@pushforge/builder": "^2.0.5"
  }
}
