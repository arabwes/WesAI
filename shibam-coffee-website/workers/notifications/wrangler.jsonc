{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "shibam-team-notifications",
  "main": "src/index.js",
  "compatibility_date": "2026-08-24",
  "d1_databases": [
    {
      "binding": "TEAM_DB",
      "database_name": "shibam-team",
      "database_id": "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "shibam-team-notifications",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "shibam-team-notifications-dead-letter"
      }
    ]
  },
  "triggers": {
    "crons": ["17 7 * * *"]
  },
  "vars": {
    "EMAIL_FROM": "Shibam Coffee Team <schedule@shibamatlanta.com>",
    "PORTAL_ORIGIN": "https://www.shibamatlanta.com"
  },
  "observability": {
    "enabled": true
  }
}
